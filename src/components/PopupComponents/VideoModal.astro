---
import CloseButton from '@components/ButtonComponents/CloseButton.astro';
import ModalWrapper from '@components/PopupComponents/ModalWrapper.astro';

const { modalID, heading, embedUrl = "https://www.youtube.com/embed/c1Eeu0lsozc"  } = Astro.props;
---
<ModalWrapper modalID={modalID}>
	<div class="VideoModal">
		<div class="modalClose" data-modal-close>
			<CloseButton/>
		</div>
		
		<div class="modalContent">
			<div class="heading">
				<h2>{heading}</h2>
			</div>
			<div class="videoContainer">
				<!-- <iframe 
					src={embedUrl}
					title="YouTube video player"
					frameborder="0"
					allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
					allowfullscreen
				></iframe> -->
				<iframe 
					width="560" 
					height="315" 
					src={embedUrl}
					title="YouTube video player" 
					frameborder="0" 
					allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
					referrerpolicy="strict-origin-when-cross-origin" 
					allowfullscreen
				></iframe>
			</div>
		</div>
	</div>
</ModalWrapper>


<style lang="scss">
	.VideoModal {
		border: var(--border-settings-main);
		box-shadow: var(--shadow-1);
		background-color: var(--background-color);
		padding: var(--padding-1);
		width: 100%;
		height: 100%;
	}

	.modalClose {
		position: absolute;
		top: -1rem;
		right: -1rem;
	}

	.videoContainer {
		position: relative;
		width: 100%;
		height: 100%;
		//padding-bottom: 56.25%; /* 16:9 Aspect Ratio */
		//height: 0;
		//overflow: hidden;

		iframe {
			position: absolute;
			top: 0;
			left: 0;
			//width: 100%;
			//height: 100%;
			width:560px;
			height:315px;
		}
	}
</style>

