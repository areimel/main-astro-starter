---
import Contactform from "@components/Forms/ContactForm.astro";
import Layout from "@layouts/Layout.astro";

import ContactCallToAction from "@components/contentComponents/ContactCallToAction.astro";
//import "../styles/contact.css";
---

<Layout title="Contact">
  <section class="contact-grid">
   
	<div>
		<ContactCallToAction />
    </div>
    <div>
      <Contactform />

    </div>

  </section>
</Layout>

<style>
	.contact-grid {
		display: grid;
		gap: 2.5rem;
		margin: 4rem auto 0;
	
	}

	@media (min-width: 768px) {
		.contact-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	.contact-title {
		font-weight: 500;
		font-size: 1.5rem;
		color: #1f2937;
	}

	.contact-description {
		font-size: 1.125rem;
		line-height: 1.75;
		color: #64748b;
		margin-top: 0.75rem;
	}

	.contact-info {
		margin-top: 1.25rem;
	}

	.contact-item {
		display: flex;
		align-items: center;
		margin-top: 0.5rem;
		gap: 0.5rem;
		color: #4b5563;
	}

	.contact-icon {
		width: 1rem;
		height: 1rem;
		color: #9ca3af;
	} 
</style>